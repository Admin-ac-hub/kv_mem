digraph "mini_lsm_kv" {
node [
  fontsize = "12"
];
subgraph clusterLegend {
  label = "Legend";
  color = black;
  edge [ style = invis ];
  legendNode0 [ label = "Executable", shape = egg ];
  legendNode1 [ label = "Static Library", shape = octagon ];
  legendNode2 [ label = "Shared Library", shape = doubleoctagon ];
  legendNode3 [ label = "Module Library", shape = tripleoctagon ];
  legendNode4 [ label = "Interface Library", shape = pentagon ];
  legendNode5 [ label = "Object Library", shape = hexagon ];
  legendNode6 [ label = "Unknown Library", shape = septagon ];
  legendNode7 [ label = "Custom Target", shape = box ];
  legendNode0 -> legendNode1 [ style = solid ];
  legendNode0 -> legendNode2 [ style = solid ];
  legendNode0 -> legendNode3;
  legendNode1 -> legendNode4 [ label = "Interface", style = dashed ];
  legendNode2 -> legendNode5 [ label = "Private", style = dotted ];
  legendNode3 -> legendNode6 [ style = solid ];
  legendNode0 -> legendNode7;
}
    "node0" [ label = "core_consumer_test", shape = egg ];
    "node1" [ label = "kv_core\n(kvdb)", shape = octagon ];
    "node2" [ label = "Threads::Threads", shape = pentagon ];
    "node1" -> "node2"  // kv_core -> Threads::Threads
    "node3" [ label = "kv_common", shape = octagon ];
    "node1" -> "node3"  // kv_core -> kv_common
    "node0" -> "node1" [ style = dotted ] // core_consumer_test -> kv_core
    "node4" [ label = "kv_bench", shape = egg ];
    "node4" -> "node1" [ style = dotted ] // kv_bench -> kv_core
    "node5" [ label = "kv_stress", shape = egg ];
    "node5" -> "node1" [ style = dotted ] // kv_stress -> kv_core
    "node6" [ label = "kv_test", shape = egg ];
    "node6" -> "node1" [ style = dotted ] // kv_test -> kv_core
    "node7" [ label = "legacy_compat_test", shape = egg ];
    "node7" -> "node1" [ style = dotted ] // legacy_compat_test -> kv_core
    "node8" [ label = "week5_bench", shape = egg ];
    "node8" -> "node1" [ style = dotted ] // week5_bench -> kv_core
}
